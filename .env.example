# Copie para .env e troque os segredos:  cp .env.example .env
# Gere valores fortes com:  openssl rand -hex 24

POSTGRES_DB=chatlocal
POSTGRES_USER=chatlocal
POSTGRES_PASSWORD=troque-esta-senha

# Chave do gateway LiteLLM (o backend usa a mesma)
LITELLM_MASTER_KEY=sk-troque-esta-chave

# Usada a partir do Sprint 1 (login JWT)
JWT_SECRET=troque-este-segredo

# Modelo padrão do chat (nome cadastrado no LiteLLM)
DEFAULT_CHAT_MODEL=chat-4b

# Threads de CPU para embeddings e reranker (ajuste ao seu processador)
EMBED_THREADS=6
RERANK_THREADS=4

# Fase 2 / estratégia híbrida — deixe vazio para 100% local
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# TYPESAFE_API_KEY=
